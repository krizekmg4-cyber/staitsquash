modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "api-typecheck"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "schedule-safety"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "api-build"

[[workflows.workflow]]
name = "api-typecheck"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run typecheck"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "schedule-safety"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run test:schedule"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "api-build"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run validate:bundle"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[objectStorage]
defaultBucketID = "replit-objstore-bac4d0fc-05b8-4757-af5e-c4260132e76b"

[userenv]

[userenv.shared]
CLUB_LOCKER_TOURNAMENT_IDS = "19515"
CLUB_LOCKER_PLAYER_IDS = "527745,551079,450879,465422,559727,542444"
STAFF_CLERK_USER_IDS = "user_3JsfBWuciuyLdvzsRmwzdVk5GLr,user_3JVm5QwwlINIssV6Uv4MxwSOgZa"

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 20442
externalPort = 3000

[[ports]]
localPort = 23839
externalPort = 80
